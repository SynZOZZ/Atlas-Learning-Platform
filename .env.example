# Application
NODE_ENV=development
NEXT_PUBLIC_SITE_NAME="4Z Academy"
NEXT_PUBLIC_SITE_SHORT_NAME="4Z"
NEXT_PUBLIC_SUPPORT_WHATSAPP="201000000000"
APP_URL="http://localhost:3000"

# PostgreSQL
DATABASE_URL="postgresql://atlas:atlas_change_me@localhost:5432/atlas_learning"
DATABASE_URL_DOCKER="postgresql://atlas:atlas_change_me@db:5432/atlas_learning"
POSTGRES_DB="atlas_learning"
POSTGRES_USER="atlas"
POSTGRES_PASSWORD="atlas_change_me"

# Authentication — replace before production
AUTH_SECRET="replace-with-at-least-32-random-characters"
SESSION_DAYS=7
ADMIN_NAME="Platform Owner"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"

# Payments: demo | manual | external
PAYMENT_PROVIDER=manual
PAYMENT_CHECKOUT_URL=""
PAYMENT_API_KEY=""
PAYMENT_HMAC_SECRET=""

# Protected assets
UPLOAD_DIR="./data/uploads"
MAX_UPLOAD_MB=50

# Video provider placeholders (Cloudflare Stream, Bunny Stream, Vimeo, etc.)
VIDEO_PROVIDER=external
VIDEO_ACCOUNT_ID=""
VIDEO_API_TOKEN=""
VIDEO_SIGNING_KEY=""

# Optional email for password reset and notifications
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="4Z Academy <no-reply@example.com>"
